{
  "name": "obsidian-link-previews",
  "version": "0.3.2",
  "private": true,
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --outfile=main.js --external:obsidian --external:electron --format=cjs --platform=browser --sourcemap",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --outfile=main.js --external:obsidian --external:electron --format=cjs --platform=browser --minify",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate-install": "node scripts/validate-install.mjs",
    "smoke": "node tests/runtime-smoke.mjs",
    "ci": "npm run lint && npm run build && npm test && npm run validate-install && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.5.0"
  }
}
